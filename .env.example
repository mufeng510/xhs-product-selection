# 数据库：默认 SQLite（数据文件在容器卷 /data/app/xhs_selection.db）
# 如需 PostgreSQL，取消注释并指向你的实例：
# DATABASE_URL=postgresql+asyncpg://xhs:change_me@postgres:5432/xhs_selection

TZ=Asia/Shanghai
XHS_PROFILE=pc
LOG_LEVEL=INFO
APP_PORT=8000
XDG_CONFIG_HOME=/data/xhs
AIONE_XHS_PC_COOKIES=
AIONE_XHS_QIANFAN_COOKIES=
XHS_COOKIE=
AIONE_XHS_COOKIES=
WECHAT_WEBHOOK_URL=
ADMIN_TOKEN=
XHS_REQUEST_TIMEOUT=30
XHS_RATE_DELAY=1.0
XHS_CONCURRENCY=1
HOT_LIKE_WEIGHT=0.35
HOT_COLLECT_WEIGHT=0.30
HOT_COMMENT_WEIGHT=0.20
HOT_ENGAGEMENT_WEIGHT=0.10
HOT_BASELINE_WEIGHT=0.05
# 自定义镜像名（本地构建或私有仓库时使用）
IMAGE=jerry0510/xhs-product-selection:latest
